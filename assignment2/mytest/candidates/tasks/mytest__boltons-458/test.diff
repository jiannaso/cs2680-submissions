+def test_vendored_omd_addlist_iterator():
+    # Added for this mytest task (not upstream): urlutils carries its own copy of
+    # OrderedMultiDict, and the upstream fix changed its addlist() too.
+    from boltons.urlutils import OrderedMultiDict as UOMD
+    omd = UOMD()
+    omd.addlist('a', iter([1, 2, 3]))
+    omd.addlist('b', (x for x in [4, 5]))
+    assert omd.keys() == ['a', 'b']
+    assert omd.getlist('a') == [1, 2, 3]
+    assert omd.getlist('b') == [4, 5]
+
+    e_omd = UOMD()
+    e_omd.addlist('a', (x for x in []))
+    assert len(e_omd) == 0
+    assert e_omd.keys() == []
