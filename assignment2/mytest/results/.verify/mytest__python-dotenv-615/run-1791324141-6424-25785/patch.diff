+def _resolve_path(path: Optional[StrPath]) -> Optional[StrPath]:
+    """Expand ~ in a path while preserving its type (str, Path, or None)."""
+    if path is None:
+        return None
+    expanded = os.path.expanduser(path)
+    if isinstance(path, pathlib.Path):
+        return pathlib.Path(expanded)
+    return expanded
