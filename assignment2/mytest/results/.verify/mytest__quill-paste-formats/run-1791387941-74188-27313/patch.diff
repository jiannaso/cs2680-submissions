diff --git a/packages/quill/test/unit/modules/clipboard_unsupported.spec.ts b/packages/quill/test/unit/modules/clipboard_unsupported.spec.ts
new file mode 100644
index 0000000..40bf791
--- /dev/null
+++ b/packages/quill/test/unit/modules/clipboard_unsupported.spec.ts
@@ -0,0 +1,103 @@
+import Delta from 'quill-delta';
+import { describe, expect, test } from 'vitest';
+import Quill from '../../../src/core';
+import Bold from '../../../src/formats/bold';
+import Italic from '../../../src/formats/italic';
+import Strike from '../../../src/formats/strike';
+import CodeBlock from '../../../src/formats/code';
+import Header from '../../../src/formats/header';
+import { ColorClass, ColorStyle } from '../../../src/formats/color';
+import { DirectionAttribute, DirectionClass, DirectionStyle } from '../../../src/formats/direction';
+import {
+  TableBody,
+  TableContainer,
+  TableCell,
+  TableRow,
+} from '../../../src/formats/table';
+import Link from '../../../src/formats/link';
+import List, { ListContainer } from '../../../src/formats/list';
+import IndentClass from '../../../src/formats/indent';
+import Image from '../../../src/formats/image';
+import Video from '../../../src/formats/video';
+import { createRegistry } from '../__helpers__/factory';
+
+describe('Clipboard - unsupported formats', () => {
+  const createMinimalClipboard = () => {
+    const container = document.body.appendChild(
+      document.createElement('div'),
+    );
+    // No Bold, Italic, Strike, Code, Direction, Color registered
+    const registry = createRegistry([
+      Header,
+      TableBody,
+      TableContainer,
+      TableCell,
+      TableRow,
+      ListContainer,
+      List,
+      IndentClass,
+      Image,
+      Video,
+      Link,
+    ]);
+    const quill = new Quill(container, { registry });
+    return quill.clipboard;
+  };
+
+  test('drops code-block format when not registered', () => {
+    const delta = createMinimalClipboard().convert({ html: '<pre> 01 \n 23 </pre>' });
+    // Without code-block registered: plain text, no trailing newline
+    expect(delta).toEqual(new Delta().insert(' 01 \n 23 '));
+  });
+
+  test('drops direction format when not registered', () => {
+    const delta = createMinimalClipboard().convert({ html: '<p style="direction:rtl;">Test</p>' });
+    expect(delta).toEqual(new Delta().insert('Test'));
+  });
+
+  test('drops color format when not registered', () => {
+    const delta = createMinimalClipboard().convert({ html: '<span style="color: red;"><span style="color: blue;">Test</span></span>' });
+    expect(delta).toEqual(new Delta().insert('Test'));
+  });
+
+  test('drops bold/italic/strike when not registered', () => {
+    const delta = createMinimalClipboard().convert({ html: '<b>Bold</b><i>Italic</i><strike>Strikethrough</strike>' });
+    expect(delta).toEqual(new Delta().insert('Bold').insert('Italic').insert('Strikethrough'));
+  });
+});
+
+describe('Clipboard - supported formats', () => {
+  const createClipboardWithFormats = (formats: unknown[]) => {
+    const container = document.body.appendChild(
+      document.createElement('div'),
+    );
+    const registry = createRegistry(formats);
+    const quill = new Quill(container, { registry });
+    return quill.clipboard;
+  };
+
+  test('keeps code-block format when registered', () => {
+    const delta = createClipboardWithFormats([CodeBlock]).convert({ html: '<pre> 01 \n 23 </pre>' });
+    expect(delta).toEqual(new Delta().insert(' 01 \n 23 \n', { 'code-block': true }));
+  });
+
+  test('keeps direction format when registered', () => {
+    const delta = createClipboardWithFormats([DirectionStyle]).convert({ html: '<p style="direction:rtl;">Test</p>' });
+    expect(delta).toEqual(new Delta().insert('Test\n', { direction: 'rtl' }));
+  });
+
+  test('keeps color format when registered', () => {
+    const delta = createClipboardWithFormats([ColorStyle]).convert({ html: '<span style="color: red;"><span style="color: blue;">Test</span></span>' });
+    expect(delta).toEqual(new Delta().insert('Test', { color: 'blue' }));
+  });
+
+  test('keeps bold/italic/strike when registered', () => {
+    const delta = createClipboardWithFormats([Bold, Italic, Strike]).convert({ html: '<b>Bold</b><i>Italic</i><strike>Strikethrough</strike>' });
+    expect(delta).toEqual(
+      new Delta()
+        .insert('Bold', { bold: true })
+        .insert('Italic', { italic: true })
+        .insert('Strikethrough', { strike: true }),
+    );
+  });
+});
