diff --git a/packages/quill/test/unit/modules/clipboard_unsupported.spec.ts b/packages/quill/test/unit/modules/clipboard_unsupported.spec.ts
new file mode 100644
index 0000000..48cd56d
--- /dev/null
+++ b/packages/quill/test/unit/modules/clipboard_unsupported.spec.ts
@@ -0,0 +1,84 @@
+import Delta from 'quill-delta';
+import { describe, expect, test } from 'vitest';
+import Quill from '../../../src/core';
+import Bold from '../../../src/formats/bold';
+import Italic from '../../../src/formats/italic';
+import Strike from '../../../src/formats/strike';
+import { createRegistry } from '../__helpers__/factory';
+
+// Test: unsupported format should be dropped when not registered
+describe('clipboard unsupported formats', () => {
+  test('strike without strike format registered', () => {
+    const container = document.body.appendChild(document.createElement('div'));
+    // Register Bold and Italic but NOT Strike
+    const registry = createRegistry([Bold, Italic]);
+    const quill = new Quill(container, { registry });
+    quill.setSelection(2, 5);
+    
+    const delta = quill.clipboard.convert({ html: '<strike>Test</strike>' });
+    // Should be plain text, no strike format (inline element, no trailing newline)
+    expect(delta).toEqual(new Delta().insert('Test'));
+  });
+
+  test('bold without bold format registered', () => {
+    const container = document.body.appendChild(document.createElement('div'));
+    // Don't register Bold
+    const registry = createRegistry([]);
+    const quill = new Quill(container, { registry });
+    quill.setSelection(2, 5);
+    
+    const delta = quill.clipboard.convert({ html: '<b>Bold</b>' });
+    // Should be plain text, no bold format (inline element, no trailing newline)
+    expect(delta).toEqual(new Delta().insert('Bold'));
+  });
+
+  test('italic without italic format registered', () => {
+    const container = document.body.appendChild(document.createElement('div'));
+    // Don't register Italic
+    const registry = createRegistry([]);
+    const quill = new Quill(container, { registry });
+    quill.setSelection(2, 5);
+    
+    const delta = quill.clipboard.convert({ html: '<i>Italic</i>' });
+    // Should be plain text, no italic format (inline element, no trailing newline)
+    expect(delta).toEqual(new Delta().insert('Italic'));
+  });
+
+  test('code-block without code-block format registered', () => {
+    const container = document.body.appendChild(document.createElement('div'));
+    // Don't register code-block
+    const registry = createRegistry([]);
+    const quill = new Quill(container, { registry });
+    quill.setSelection(2, 5);
+    
+    const delta = quill.clipboard.convert({ html: '<pre> 01 \n 23 </pre>' });
+    // Should be plain text, no code-block format, no trailing newline
+    expect(delta).toEqual(new Delta().insert(' 01 \n 23 '));
+  });
+
+  test('direction without direction format registered', () => {
+    const container = document.body.appendChild(document.createElement('div'));
+    // Don't register any direction attributor
+    const registry = createRegistry([]);
+    const quill = new Quill(container, { registry });
+    quill.setSelection(2, 5);
+    
+    const delta = quill.clipboard.convert({ html: '<p style="direction:rtl;">Test</p>' });
+    // Should be plain text, no direction format (paragraph not registered, so no trailing newline)
+    expect(delta).toEqual(new Delta().insert('Test'));
+  });
+
+  test('color without color format registered', () => {
+    const container = document.body.appendChild(document.createElement('div'));
+    // Don't register any color attributor
+    const registry = createRegistry([]);
+    const quill = new Quill(container, { registry });
+    quill.setSelection(2, 5);
+    
+    const delta = quill.clipboard.convert({ 
+      html: '<span style="color: red;"><span style="color: blue;">Test</span></span>' 
+    });
+    // Should be plain text, no color format
+    expect(delta).toEqual(new Delta().insert('Test'));
+  });
+});
