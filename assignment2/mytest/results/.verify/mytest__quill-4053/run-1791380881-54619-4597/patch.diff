@@ -0,0 +1,68 @@
+import * as Parchment from 'parchment';
+import type { BlotConstructor } from 'parchment';
+
+const CORE_BLOTS = [
+  'block',
+  'break',
+  'cursor',
+  'inline',
+  'scroll',
+  'text',
+];
+
+function createRegistryWithFormats(
+  formats: string[],
+  sourceRegistry: Parchment.Registry,
+  debug: { error: (message: string) => void },
+): Parchment.Registry {
+  const registry = new Parchment.Registry();
+  const registered = new Set<string>(CORE_BLOTS);
+  const inProgress = new Set<string>();
+
+  function resolveFormat(formatName: string): void {
+    // Cycle detected - we're trying to resolve something we're already resolving
+    if (inProgress.has(formatName)) {
+      debug.error(`Cycle detected in required containers`);
+      return;
+    }
+
+    // Already registered, skip
+    if (registered.has(formatName)) return;
+
+    inProgress.add(formatName);
+
+    // Check if this format exists in the source registry
+    const blotDef = sourceRegistry.query(formatName, Parchment.Scope.BLOT);
+    if (blotDef == null) {
+      debug.error(`Unknown format: ${formatName}`);
+      inProgress.delete(formatName);
+      return;
+    }
+
+    registered.add(formatName);
+
+    // Check if this blot has a requiredContainer, and register it (recursively)
+    const blotConstructor = blotDef as BlotConstructor;
+    if (blotConstructor.requiredContainer != null) {
+      resolveFormat(blotConstructor.requiredContainer.blotName);
+    }
+
+    inProgress.delete(formatName);
+  }
+
+  for (const formatName of formats) {
+    resolveFormat(formatName);
+  }
+
+  // Register all resolved formats into the new registry
+  for (const name of registered) {
+    const definition = sourceRegistry.query(name, Parchment.Scope.BLOT);
+    if (definition) {
+      registry.register(definition);
+    }
+  }
+
+  return registry;
+}
+
+export default createRegistryWithFormats;
