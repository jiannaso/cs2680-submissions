+def _move_to_next_weekday(moment: datetime.datetime, weekday: str) -> datetime.datetime:
+    """Move a naive datetime to the same time of day on the next *weekday*.
+
+    If *moment* already falls on *weekday*, the same day is returned unchanged.
+    """
+    # weekday is a lowercase string like "monday", "tuesday", etc.
+    weekday_index = WEEKDAYS.index(weekday)
+    # datetime.weekday(): 0=Monday, 6=Sunday
+    days_ahead = weekday_index - moment.weekday()
+    if days_ahead < 0:
+        # Target day already happened this week; go to next week
+        days_ahead += 7
+    return moment + datetime.timedelta(days=days_ahead)
+
 
