+    def _correct_utc_offset(
+        self,
+        moment: datetime.datetime,
+        fixate_time: bool = False,
+    ) -> datetime.datetime:
+        """Correct the UTC offset of a datetime to match its wall-clock time.
+
+        * If *moment* is naive (no timezone info) or the job has no
+          *at_time_zone*, return it unchanged.
+        * If the wall-clock time does not exist (a DST gap), ``fixate_time``
+          controls whether the time is moved forward by the gap length.
+          When ``fixate_time`` is ``True`` the result is moved to the first
+          valid time after the gap (e.g. ``02:30`` -> ``03:30`` in
+          Europe/Berlin on 2024-03-31).  When ``False`` the original
+          naive time is left as-is (with the local tzinfo attached).
+        * If the time is valid (including both occurrences of a repeated
+          / folded hour) the datetime is returned unchanged.
+        * If the datetime's offset is stale because it was produced by
+          plain ``datetime`` arithmetic (e.g. adding hours to a tz-aware
+          value), the wall-clock time is kept but the offset is adjusted
+          to the one that is valid for that wall-clock time in the
+          job's timezone.
+        """
+        import pytz
+
+        if self.at_time_zone is None or not isinstance(moment.tzinfo, pytz.tzinfo.BaseTzInfo):
+            return moment
+
+        tz = self.at_time_zone
+        wall = moment.replace(tzinfo=None)
+
+        # Try to localise the wall-clock time with pytz.
+        # pytz.localize raises for non-existent times or ambiguous times
+        # unless we use is_dst=None.
+        try:
+            localized = tz.localize(wall, is_dst=None)
+        except pytz.exceptions.NonExistentTimeError:
+            # The wall-clock time falls in a DST gap.
+            if fixate_time:
+                # Find the gap size by comparing the two possible offsets.
+                before = tz.localize(wall, is_dst=False)
+                after = tz.localize(wall, is_dst=True)
+                gap = after.utcoffset() - before.utcoffset()
+                result = wall + gap
+                return result.replace(tzinfo=after.tzinfo)
+            return moment
+        except pytz.exceptions.AmbiguousTimeError:
+            # The wall-clock time is in a repeated (folded) hour.
+            # Both is_dst=True and is_dst=False are valid.
+            # The moment already has a specific offset, so leave it unchanged.
+            return moment
+
+        try:
+            # Check whether the *original* offset matches what pytz says
+            # should be the offset for this wall-clock time.
+            expected_offset = localized.utcoffset()
+            actual_offset = moment.utcoffset()
+            if actual_offset != expected_offset:
+                # The offset is stale – correct it but keep the wall time.
+                return wall.replace(tzinfo=pytz.FixedOffset(expected_offset.total_seconds() / 60))
+        except (AttributeError, TypeError):
+            pass
+
+        return moment
+
