+def _move_to_next_weekday(moment: datetime.datetime, weekday: str) -> datetime.datetime:
+    """Return the same time of day on the next *weekday* (or the same day if it already matches).
+
+    *moment* is a naive datetime. *weekday* is a lower-case weekday name
+    (e.g. ``"monday"``, ``"tuesday"``).
+
+    Monday 2024-05-13 10:27:54 with ``"monday"`` stays the 13th.
+    With ``"tuesday"`` it gives the 14th.
+    Wednesday the 15th with ``"tuesday"`` gives the 21st.
+    """
+    target = _WEEKDAY_NAMES.index(weekday)
+    days_ahead = target - moment.weekday()
+    if days_ahead < 0:
+        days_ahead += 7
+    return moment + datetime.timedelta(days=days_ahead)
+
