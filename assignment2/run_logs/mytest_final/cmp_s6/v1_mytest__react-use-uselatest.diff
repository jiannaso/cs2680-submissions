@@ -0,0 +1,13 @@
+import { useEffect, useRef } from 'react';
+
+const useLatest = <T>(value: T): React.MutableRefObject<T> => {
+  const ref = useRef<T>(value);
+
+  useEffect(() => {
+    ref.current = value;
+  });
+
+  return ref;
+};
+
+export default useLatest;
