+    def get_statement_values(self, property_id: str) -> list[str]:
+        """
+        Retrieve all string values associated with a given property from the
+        entity's statements. Skips malformed entries and returns an empty list
+        if the property is missing or no valid values are found.
+        """
+        statements = self.statements.get(property_id, [])
+        values: list[str] = []
+        for stmt in statements:
+            try:
+                mainsnak = stmt.get("mainsnak", {})
+                datavalue = mainsnak.get("datavalue", {})
